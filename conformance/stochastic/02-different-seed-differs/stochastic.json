{
  "id": "exit_value_distribution",
  "label": "Exit Value",
  "base_formula": "noi_model.net_operating_income / dcf.exit_cap_rate",
  "inputs": [
    {
      "variable": "noi_model.net_operating_income",
      "distribution": {
        "kind": "uniform",
        "min": 540000,
        "max": 660000
      }
    },
    {
      "variable": "dcf.exit_cap_rate",
      "distribution": {
        "kind": "uniform",
        "min": 0.05,
        "max": 0.07
      }
    }
  ],
  "samples": 1000,
  "seed": 43,
  "summarize": [
    "mean",
    "median",
    "p10",
    "p90",
    "min",
    "max",
    "stddev"
  ],
  "round_to": 2
}
