{
  "description": "RFC 0099 statement homes. Each case applies section-scoped (or frontmatter-scoped) text edits to a builtin example and states the outcome owed at bound addresses. A +10% tamper of a section-home figure is failed at that address, while its quick_metrics copy keeps its own outcome. An unbound look-alike field yields no statement. The two identity aliases (the metric is the field itself) can only agree, so they pin verified.",
  "cases": [
    {
      "name": "cap_rate-going-in-agrees",
      "example": "Agave-Court-Apts-Scottsdale-AZ.uwx.md",
      "edits": [],
      "expect": [
        {
          "path": "valuation.going_in_cap_rate",
          "state": "verified"
        },
        {
          "path": "quick_metrics.cap_rate",
          "state": "verified"
        }
      ]
    },
    {
      "name": "cap_rate-going-in-disagrees-quick-agrees",
      "example": "Agave-Court-Apts-Scottsdale-AZ.uwx.md",
      "edits": [
        {
          "section": "valuation",
          "find": "\"going_in_cap_rate\": 0.0542",
          "replace": "\"going_in_cap_rate\": 0.0596"
        }
      ],
      "expect": [
        {
          "path": "valuation.going_in_cap_rate",
          "state": "failed"
        },
        {
          "path": "quick_metrics.cap_rate",
          "state": "verified"
        }
      ],
      "failed": 1
    },
    {
      "name": "cap_rate-unbound-look-alike-is-not-a-statement",
      "example": "Agave-Court-Apts-Scottsdale-AZ.uwx.md",
      "edits": [
        {
          "section": "valuation",
          "find": "\"going_in_cap_rate\": 0.0542,",
          "replace": "\"going_in_cap_rate\": 0.0542,\n  \"cap_rate_trailing\": 0.9,"
        }
      ],
      "expect": [
        {
          "path": "valuation.going_in_cap_rate",
          "state": "verified"
        }
      ],
      "absent": [
        "valuation.cap_rate_trailing"
      ],
      "failed": 0
    },
