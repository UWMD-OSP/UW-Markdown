{
  "manifest_version": "1",
  "id": "com.example.datacenters",
  "name": "Data Center Module",
  "version": "0.1.0",
  "description": "Declares com.example.specialty_facility with an industrial fallback, so a reader without this module renders degraded rather than refusing.",
  "authors": [
    "UW Markdown contributors"
  ],
  "license": "MIT",
  "requires_protocol": "^4.0.0",
  "requires_format": "^3.0",
  "declares_asset_classes": [
    {
      "id": "com.example.specialty_facility",
      "display_name": "Data Center",
      "fallback": "industrial",
      "required_sections": [
        "power_capacity"
      ]
    }
  ],
  "requires_conformance": "reader"
}
