{
  "manifest_version": "1",
  "id": "org.uwmd.reject",
  "name": "Reject Fixture",
  "version": "1.0.0",
  "description": "A manifest a conforming host must refuse.",
  "authors": [
    "UW Markdown contributors"
  ],
  "license": "MIT",
  "requires_protocol": "^4.0.0",
  "requires_format": "^3.0",
  "calculations": [
    {
      "id": "x",
      "label": "X",
      "formula": "1 + 1",
      "deterministic": false
    }
  ],
  "requires_conformance": "verifier",
  "requires_profiles": [
    "module"
  ]
}
