{
  "manifest_version": "1",
  "id": "org.uwmd.reject",
  "name": "Reject Fixture",
  "version": "1.0.0",
  "description": "A manifest a conforming host must refuse.",
  "authors": [
    "UW Markdown contributors"
  ],
  "license": "MIT",
  "requires_protocol": "^4.0.0",
  "requires_format": "^3.0",
  "agent_layers": [
    {
      "id": "L7_concessions",
      "reads": [
        "rent_roll"
      ],
      "writes": [
        "x_mod_concession_analysis"
      ],
      "prompt_template": "Extract concession terms from the offering memorandum."
    }
  ],
  "requires_conformance": "verifier"
}
