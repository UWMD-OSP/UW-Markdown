{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uwmd.org/schemas/tax-reassessment.schema.json",
  "title": "tax-reassessment",
  "description": "RFC 0081 G1 / Format §4.5. trigger required; assessment group all-or-none. Other fields admitted only with that group. TAX-01–03 evaluate only with the group. A member stated as null is not stated: jurisdiction: null needs no assessment group.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trigger"
  ],
  "properties": {
    "trigger": {
      "enum": [
        "sale",
        "construction_completion",
        "statutory_cycle",
        "none"
      ]
    },
    "jurisdiction": {
      "description": "A label. No jurisdiction rules are inferred from it.",
      "type": [
        "string",
        "null"
      ]
    },
    "value_basis": {
      "description": "The value the ratio applies to. Stated together with assessment_ratio or not at all.",
      "type": [
        "number",
        "null"
      ]
    },
    "assessment_ratio": {
      "description": "A fraction, not a percent.",
      "type": [
        "number",
        "null"
      ]
    },
    "assessed_value": {
      "type": "number"
    },
    "millage_rate": {
      "description": "A fraction, not a percent.",
      "type": "number"
    },
    "indicated_tax": {
      "description": "What the inputs above produce, before any rounding.",
      "type": "number"
    },
    "round_to_decimals": {
      "description": "Protocol VIII.5 decimals. May be negative to round to a magnitude. Absent means the currency quantum.",
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "dependentRequired": {
    "assessed_value": [
      "millage_rate",
      "indicated_tax"
    ],
    "millage_rate": [
      "assessed_value",
      "indicated_tax"
    ],
    "indicated_tax": [
      "assessed_value",
      "millage_rate"
    ]
  },
  "dependentSchemas": {
    "jurisdiction": {
      "if": {
        "properties": {
          "jurisdiction": {
            "type": "null"
          }
        }
      },
      "else": {
        "required": [
          "assessed_value",
          "millage_rate",
          "indicated_tax"
        ]
      }
    },
    "value_basis": {
      "if": {
        "properties": {
          "value_basis": {
            "type": "null"
          }
        }
      },
      "else": {
        "required": [
          "assessed_value",
          "millage_rate",
          "indicated_tax"
        ]
      }
    },
    "assessment_ratio": {
      "if": {
        "properties": {
          "assessment_ratio": {
            "type": "null"
          }
        }
      },
      "else": {
        "required": [
          "assessed_value",
          "millage_rate",
          "indicated_tax"
        ]
      }
    },
    "round_to_decimals": {
      "if": {
        "properties": {
          "round_to_decimals": {
            "type": "null"
          }
        }
      },
      "else": {
        "required": [
          "assessed_value",
          "millage_rate",
          "indicated_tax"
        ]
      }
    }
  }
}
