<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:uw="https://uwmd.org/ns/document/2" targetNamespace="https://uwmd.org/ns/document/2" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:annotation><xs:documentation>Structural tooling for UW XML2.0. The codec enforces the total typed-tree grammar, canonical ASCII JSON string tokens, expanded names, duplicate names, full Envelope schema and complete semantic digest (RFC0089; UW_XML_MAPPING.md).</xs:documentation></xs:annotation>
  <xs:simpleType name="valueType"><xs:restriction base="xs:string">
    <xs:enumeration value="object"/><xs:enumeration value="array"/><xs:enumeration value="string"/><xs:enumeration value="number"/><xs:enumeration value="boolean"/><xs:enumeration value="null"/>
  </xs:restriction></xs:simpleType>
  <xs:complexType name="value" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded"><xs:element ref="uw:value"/><xs:element ref="uw:member"/></xs:choice>
    <xs:attribute name="type" type="uw:valueType" use="required"/>
  </xs:complexType>
  <xs:element name="value" type="uw:value"/>
  <xs:element name="member"><xs:complexType><xs:sequence><xs:element ref="uw:value"/></xs:sequence><xs:attribute name="name-json" type="xs:string" use="required"/></xs:complexType></xs:element>
  <xs:element name="document"><xs:complexType><xs:sequence><xs:element ref="uw:value"/></xs:sequence><xs:attribute name="envelope-version" type="xs:string" use="required" fixed="2.0"/><xs:attribute name="format-version" type="xs:string" use="required" fixed="3.0"/></xs:complexType></xs:element>
</xs:schema>
