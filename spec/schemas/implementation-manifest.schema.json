{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uwmd.org/schemas/implementation-manifest.schema.json",
  "title": "UW Implementation Manifest",
  "description": "Self-declaration that any conforming UW Markdown implementation SHOULD expose so consumers can discover what tier, verification profiles, capabilities, and asset classes it supports. Mirrors the ImplementationManifest interface in @uwmd/verify's protocol.ts. See UW_PROTOCOL.md §I.4 and Part II (Protocol 4.0 conformance model, RFC 0078).",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "protocol_version",
    "format_version"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 128,
      "description": "Stable identifier. Reverse-DNS recommended (e.g. 'io.uwmd.web-viewer')."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "description": "Implementation semver."
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Protocol semver this implementation targets (e.g. '1.0.0')."
    },
    "format_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Format semver this implementation can read (e.g. '1.1')."
    },
    "tier": {
      "enum": [
        "reader",
        "verifier"
      ],
      "description": "Optional conformance tier; Verifier includes Reader. Partial capabilities may be stated without a tier (Protocol §II.5). No aliases."
    },
    "profiles": {
      "type": "array",
      "items": {
        "enum": [
          "module",
          "integrity",
          "representations",
          "portfolio",
          "sensitivity",
          "stochastic"
        ]
      },
      "uniqueItems": true,
      "description": "Optional verification profiles the implementation claims (UW_PROTOCOL §II.3, RFC 0078). module: evaluate module-declared and document-declared formulas. integrity: hash chains and block signatures. representations: UW Lite, XML mapping and CSV bundle. portfolio: portfolio and relationship sidecars. sensitivity: reproduce stated sensitivity grids. stochastic: reproduce stated seeded distributions. A profile adds to either tier. Absent means none."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "parse",
          "validate",
          "render-json",
          "render-csv",
          "render-summary",
          "render-chat",
          "render-pdf",
          "render-docx",
          "edit-replace",
          "edit-supersede",
          "edit-frontmatter",
          "calc-evaluate",
          "calc-deterministic",
          "calc-stochastic",
          "calc-sensitivity",
          "calc-cash-flow",
          "portfolio-relationships",
          "agent-host",
          "module-load",
          "signing",
          "document-signature-verification",
          "capability-verify",
          "module-signature-verification",
          "integrity",
          "refinement"
        ]
      },
      "uniqueItems": true,
      "description": "Finer-grained capability flags. Tier and profiles carry the conformance claim; capabilities advertise partial conformance, and the starter-product claims (edit-*, render-*, agent-host, refinement, capability-verify) that are outside the Protocol's tiers (UW_PROTOCOL §II.4)."
    },
    "representations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/representationCapability"
      },
      "uniqueItems": true,
      "description": "Machine-readable representation support (Protocol 1.2+)."
    },
    "supported_locales": {
      "type": "array",
      "items": {
        "enum": [
          "en-US",
          "en-GB",
          "de-DE",
          "fr-FR",
          "ja-JP",
          "zh-CN"
        ]
      },
      "uniqueItems": true,
      "minItems": 1,
      "description": "Display locales this implementation renders (RFC 0001). Absent means ['en-US']. A display render of a file whose declared locale is outside this list is refused with LOC-01, never silently rendered in a different locale. Locale governs display only - content is canonical and locale-free."
    },
    "asset_classes": {
      "type": "array",
      "items": {
        "enum": [
          "multifamily",
          "office",
          "retail",
          "industrial",
          "self_storage",
          "hospitality",
          "mixed_use",
          "senior_housing",
          "student_housing",
          "land",
          "data_center",
          "manufactured_housing"
        ]
      },
      "uniqueItems": true,
      "description": "Asset classes the implementation specifically supports. Omit to mean 'all'."
    },
    "role": {
      "enum": [
        "web",
        "cli",
        "desktop",
        "ide-extension",
        "library",
        "service"
      ],
      "description": "Form factor of the implementation. Informational."
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "description": "Public homepage / docs URL."
    }
  },
  "$defs": {
    "representationCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "media_types",
        "file_extensions",
        "directions",
        "fidelity",
        "representation_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "media_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^/\\s]+/[^/\\s]+$"
          }
        },
        "file_extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.[A-Za-z0-9._-]+$"
          }
        },
        "directions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "fidelity": {
          "enum": [
            "source",
            "model",
            "view"
          ]
        },
        "representation_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "view": {
          "type": "string",
          "minLength": 1
        },
        "streaming": {
          "type": "boolean"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "fidelity": {
                "const": "view"
              }
            }
          },
          "then": {
            "required": [
              "view"
            ]
          }
        }
      ]
    }
  },
  "examples": [
    {
      "id": "io.uwmd.core",
      "name": "@uwmd/core",
      "version": "0.1.0",
      "protocol_version": "1.0.0",
      "format_version": "1.1",
      "tier": "verifier",
      "profiles": [
        "module",
        "integrity"
      ],
      "capabilities": [
        "parse",
        "validate",
        "render-summary",
        "render-chat",
        "edit-replace",
        "edit-supersede",
        "edit-frontmatter",
        "calc-evaluate",
        "calc-deterministic",
        "module-load",
        "integrity",
        "agent-host"
      ],
      "role": "library",
      "homepage": "https://uwmd.org"
    }
  ]
}
