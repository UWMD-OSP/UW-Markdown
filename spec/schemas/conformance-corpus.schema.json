{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uwmd.org/schemas/conformance-corpus.schema.json",
  "title": "Conformance corpus ownership index",
  "type": "object",
  "required": [
    "schema_version",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "suite",
          "scenario",
          "target"
        ],
        "properties": {
          "suite": {
            "type": "string",
            "minLength": 1
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "enum": [
              "reader",
              "verifier",
              "module",
              "integrity",
              "representations",
              "portfolio",
              "sensitivity",
              "stochastic",
              "starter-products"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
