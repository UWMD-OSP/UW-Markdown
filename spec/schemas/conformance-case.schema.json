{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uwmd.org/schemas/conformance-case.schema.json",
  "title": "Conformance CLI case (RFC 0078)",
  "type": "object",
  "required": [
    "id",
    "target",
    "format_version",
    "command",
    "args",
    "fixture_dir",
    "expect"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "enum": [
        "reader",
        "verifier",
        "module",
        "integrity",
        "representations",
        "portfolio",
        "sensitivity",
        "stochastic",
        "pro-forma",
        "starter-products"
      ]
    },
    "format_version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+$",
      "description": "The Format version the case was written for, which names the rule set it exercises (UW_PROTOCOL \u00a7XII.5, RFC 0111 D6). A Verifier passes the cases of every rule set it keeps."
    },
    "requires_capabilities": {
      "type": "array",
      "items": {
        "$ref": "https://uwmd.org/schemas/implementation-manifest.schema.json#/properties/capabilities/items"
      },
      "uniqueItems": true
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fixture_dir": {
      "type": "string"
    },
    "expect": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
