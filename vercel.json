{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm --prefix tools/docs-site ci && npm --prefix tools/web-editor ci",
  "buildCommand": "npm run build -w @uwmd/core && npm --prefix tools/docs-site run prebuild && npm --prefix tools/web-editor run build && node tools/docs-site/scripts/prepare-public.mjs && cd tools/docs-site && npm exec vitepress build",
  "outputDirectory": "tools/docs-site/.vitepress/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(llms.txt|llms-full.txt)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600" }
      ]
    },
    {
      "source": "/downloads/templates/blank-screener.uw.md",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"blank-screener.uw.md\"" }
      ]
    },
    {
      "source": "/downloads/templates/blank-analyst.uw.md",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"blank-analyst.uw.md\"" }
      ]
    }
  ]
}
