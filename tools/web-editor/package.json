{
  "name": "@uwmd/web-editor",
  "private": true,
  "version": "0.5.0",
  "description": "Calc-aware web editor for .uw.md files. Embeds the @uwmd/core parser, validator, Tier-2 dispatcher, Tier-3 calc engine, and the §7.1/§7.2 report renderer in the browser so derived values never drift from inputs and the lender package is always one tab away.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@uwmd/core": "file:../../packages/uwmd-core",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.6"
  }
}
