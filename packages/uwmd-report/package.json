{
  "name": "@uwmd/report",
  "version": "0.8.0",
  "description": "PDF report pipeline for UW Markdown — render the lender package / credit memo HTML from @uwmd/core to PDF via headless Chromium (system Chrome/Edge through playwright-core).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UWMD-OSP/UW-Markdown.git",
    "directory": "packages/uwmd-report"
  },
  "homepage": "https://uwmd.org",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "uwmd-report": "bin/uwmd-report.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@uwmd/core": "1.9.0",
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "keywords": [
    "uwmd",
    "underwriting",
    "commercial-real-estate",
    "pdf",
    "lender-package",
    "credit-memo"
  ]
}
