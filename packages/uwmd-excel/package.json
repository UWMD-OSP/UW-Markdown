{
  "name": "@uwmd/excel",
  "version": "0.1.0",
  "description": "Excel converter for UW Markdown — emit a live multifamily underwriting workbook from a .uw.md file. Derived metrics ship as formulas (not pre-computed values) so Excel and the @uwmd/core calc engine stay in sync by construction.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaredmaxey/Underwriting-Markdown-Private-1.0.git",
    "directory": "packages/uwmd-excel"
  },
  "homepage": "https://github.com/jaredmaxey/Underwriting-Markdown-Private-1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "uwmd-excel": "bin/uwmd-excel.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@uwmd/core": "1.0.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "keywords": [
    "uwmd",
    "underwriting",
    "commercial-real-estate",
    "excel",
    "xlsx",
    "multifamily"
  ]
}
