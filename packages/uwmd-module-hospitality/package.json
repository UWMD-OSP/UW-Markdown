{
  "name": "@uwmd/module-hospitality",
  "version": "0.2.0",
  "description": "Compatibility shell for the retired official hospitality module (RFC 0006). Since RFC 0080 its hotel sections, calculations and rules are part of the builtin hospitality class in @uwmd/core; this package declares nothing and exists so existing installs and org.uwmd.hospitality module lists keep resolving.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UWMD-OSP/UW-Markdown.git",
    "directory": "packages/uwmd-module-hospitality"
  },
  "homepage": "https://uwmd.org",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/emit-manifest.mjs",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@uwmd/core": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "keywords": [
    "uwmd",
    "underwriting",
    "commercial-real-estate",
    "hospitality",
    "hotel",
    "revpar",
    "module"
  ],
  "publishConfig": {
    "access": "public"
  }
}
