{
  "name": "@uwmd/lake",
  "version": "0.1.0",
  "description": "Reference PostgreSQL/JSONB lake adapter for UW Markdown (RFC 0049) — plans idempotent, parameterized load statements for canonical envelopes, block-value facts, receipts and package manifests without taking a database driver as a dependency.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UWMD-OSP/UW-Markdown.git",
    "directory": "packages/uwmd-lake"
  },
  "homepage": "https://uwmd.org",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@uwmd/core": "2.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "keywords": [
    "uwmd",
    "underwriting",
    "commercial-real-estate",
    "postgresql",
    "jsonb",
    "data-lake"
  ]
}
