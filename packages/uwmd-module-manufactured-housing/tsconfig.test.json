{
  // The package tsconfig excludes *.test.ts, because tests are not part of the
  // published build. The side effect is that nothing type-checks them: vitest
  // transforms through esbuild, which strips types without reading them. This
  // config exists only to type-check. It emits nothing.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
