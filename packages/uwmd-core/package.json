{
  "name": "@uwmd/core",
  "version": "1.3.0",
  "description": "Reference implementation of the UW Markdown standard — parser, validator, renderer, and CLI for .uw.md underwriting files.",
  "repository": {
    "type": "git",
    "url": "https://github.com/UWMD-OSP/UW-Markdown.git",
    "directory": "packages/uwmd-core"
  },
  "homepage": "https://uwmd.org",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.test.*",
    "!dist/**/*.property.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "parse": "node dist/cli.js parse",
    "validate": "node dist/cli.js validate",
    "summary": "node dist/cli.js summary",
    "prepublishOnly": "npm run build && npm test && npm --prefix ../.. run conformance && npm --prefix ../.. run validate-schemas"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "fast-check": "^3.23.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.91.1"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  }
}
