{
  "name": "@uwmd/core",
  "version": "4.0.1",
  "description": "The UW Markdown starter toolkit — editor, renderer, report, defaults and cascade, refinement, Excel emission, agents and the CLI for .uw.md underwriting files, on top of @uwmd/verify (the reference implementation of the standard), whose whole API it re-exports.",
  "repository": {
    "type": "git",
    "url": "https://github.com/UWMD-OSP/UW-Markdown.git",
    "directory": "packages/uwmd-core"
  },
  "homepage": "https://uwmd.org",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.test.*",
    "!dist/**/*.property.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "parse": "node dist/cli.js parse",
    "validate": "node dist/cli.js validate",
    "summary": "node dist/cli.js summary",
    "prepublishOnly": "npm --prefix ../uwmd-verify run build && npm run build && npm test && npm --prefix ../.. run conformance && npm --prefix ../.. run validate-schemas"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "fast-check": "^3.23.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@uwmd/verify": "0.1.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@uwmd/signing": "0.3.1"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@uwmd/signing": {
      "optional": true
    }
  }
}
