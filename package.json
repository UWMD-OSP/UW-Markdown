{
  "name": "uwmd-monorepo",
  "private": true,
  "description": "UW Markdown — open-source standard for underwriting documents.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @uwmd/core",
    "test": "npm test -w @uwmd/core",
    "cli": "node packages/uwmd-core/dist/cli.js",
    "conformance": "node scripts/run-conformance.mjs",
    "validate-schemas": "node scripts/validate-schemas.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
