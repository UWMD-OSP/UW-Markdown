  "findings": [
    {
      "id": "STACK-F3",
      "classification": "Current adapted writer emits both canonical flags",
      "evidence": [
        "meta-v2.ts toFormat3Meta225-237",
        "serialize.ts publicGrammar/format2/specVersion gate109-111 and metadata329-333",
        "export-to-uwmd.ts format3=true331/default version3.088/specVersion352-354"
      ],
      "consequence": "Omitted typed flat flags become explicit false/false on current Format3 output; candidate META02/03 do not fire for these metadata values. No permission to infer truth of other authored data."
    },
    {
      "id": "STACK-OLD",
      "classification": "Historical/direct helper literal omissions",
      "evidence": [
        "meta-v2.ts reshapeMetaV1toV2145-179"
      ],
      "consequence": "This helper retains omissions in the old Format2 shape. Bypassing toFormat3Meta or relabelling its output3.0 can owe META02/03. Not evidence that current production Format3 writer omits flags."
    },
    {
      "id": "STACK-CONSUMERS",
      "classification": "Production source call graph, not deployed runtime proof",
      "evidence": [
        "backend/routes/exports.ts",
        "backend/routes/engine.ts",
        "backend/services/mcp/tools/export.ts",
        "backend/services/uwmd/httpBinding.ts",
        "backend/services/lake/dealDocumentSource.ts"
      ],
      "consequence": "Calls exportService.exportToUwmd without production withdrawal flags; markdown serialize and envelopeMapping.toPublicBlock adapt through Format3. Envelope path builds canonical meta in both block.meta and block.content._meta."
    },
    {
      "id": "STACK-MARKET",
      "classification": "Separate literal canonical writer includes flags",
      "evidence": [
        "backend/services/uwmd/marketDataDocument.ts268-277"
      ],
      "consequence": "Review=false and superseded=false are authored explicitly; no candidate flag omission on that shape."
    },
    {
      "id": "STACK-WATERMARK",
      "classification": "Flat internal omission is adapted at final serialization",
      "evidence": [
        "backend/services/uwmdWatermark.ts119-140/246/398"
      ],
      "consequence": "Watermark/chain/narrative internal flat metadata need not contain flags; current final Format3 serialize supplies canonical flags. Do not treat flat intermediary as an emitted invalid block."
    },
    {
      "id": "UWMD-BUILD",
      "classification": "Canonical helper includes both flags",
      "evidence": [
        "packages/uwmd-verify/src/metadata.ts36-70"
      ],
      "consequence": "buildMeta emits review opts??false and superseded=false; init, host editor/supersede, retired agent host host, newpipeline log and Lite compilation use it. Valid typed fresh emissions avoid the candidate flags."
    },
    {
      "id": "UWMD-PATCH",
      "classification": "Sparse patch is not a full metadata object",
      "evidence": [
        "tools/web-editor/src/edits.ts132-143",
        "packages/uwmd-core/src/editor.ts781-786"
      ],
      "consequence": "Absent review checkbox member is merged with full buildMeta quality, not an omission in the final canonical object. Untyped explicit malformed patch values are not proven safe by this inventory."
    },
    {
      "id": "UWMD-PRESERVE",
      "classification": "Passthrough/restamp paths preserve existing malformed inputs",
      "evidence": [
        "packages/uwmd-core/src/runner.ts118-132",
        "packages/uwmd-core/src/editor.ts260-265",
        "packages/uwmd-verify/src/envelope.ts",
        "packages/uwmd-core/src/renderer.ts"
      ],
      "consequence": "Low-level writeAgentBlock accepts caller content meta; restamp/codecs do not promise to invent missing booleans. Existing/bypassed externally authored admitted-parent omissions can receive new errors, including retained history. This is conditional exposure, not an observed fresh-helper omission."
    },
    {
      "id": "SCOPE",
      "classification": "Bounded inventory only",
      "consequence": "No blanket guarantee over every external writer/untyped caller, all records, live service/deployed dist, source/value truth, entire interoperability domain or optional profiles. Runtime probes use explicit synthetic opaque data, no financial engine computations; historical artifacts remain untouched."
    }
  ],
